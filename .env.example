# --- Core ---
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-unique-random-secret
DATABASE_URL=postgresql+asyncpg://aether:replace-with-local-db-password@127.0.0.1:5432/aether
ACCESS_TOKEN_MINUTES=1440
ALLOW_REGISTRATION=false
CORS_ORIGINS=*

# --- Branding (defaults; editable at runtime via /api/v1/branding) ---
PRODUCT_NAME=Aether
ACCENT_COLOR=#10a37f

# --- Web app ---
API_PROXY_TARGET=http://127.0.0.1:8123

# Optional persistent directory for large local image-model weights.
AETHER_PERSISTED_MODELS_DIR=/var/lib/aether/models
